# Copy to .env and edit. All values are optional except the Hugging Face ones for `push`.

# Run containers as your user so data/results/checkpoints aren't owned by root (Linux: `id -u`, `id -g`)
UID=1000
GID=1000

# Data
START_YEAR=2015
TEST_START=2025-01-01

# Training (defaults tuned for an RTX 5080, 16 GB)
MODEL=microsoft/deberta-v3-base
RUN_NAME=deberta
EPOCHS=3
BATCH_SIZE=32
LR=2e-5
# Second run for comparison:
# MODEL=answerdotai/ModernBERT-base
# RUN_NAME=modernbert

# Zero-shot LLM baseline (LM Studio server on the host; enable "Serve on Local Network")
LLM_URL=http://host.docker.internal:1234/v1
LLM_MODEL=
LLM_N=300
LLM_MAX_TOKENS=64

# Hugging Face upload
HF_TOKEN=
HF_REPO=your-username/cvescore-deberta
